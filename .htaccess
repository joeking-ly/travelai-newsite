# ------------------------------------------------------------
# 3. Anything else under /resources/ (categories, tags, authors,
#    wp-content, unmigrated posts) -> Insights hub.
#    NOTE: bare /resources is NOT redirected - it serves the new
#    Resources (press kit) page.
# ------------------------------------------------------------
RewriteRule ^resources/.+ /insights [R=301,L]

# ------------------------------------------------------------
# 4. Clean URLs: externally strip .html
# ------------------------------------------------------------
# /index.html (any depth) -> directory root
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(.*?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
# /page.html -> /page
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+([^?\s]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# ------------------------------------------------------------
# 5. Internally serve the .html file for extension-less requests
#    (no !-d guard: /stories must serve stories.html even though
#     a stories/ directory also exists)
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

</IfModule>
