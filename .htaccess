# ============================================================
# TravelAI — clean URLs + legacy redirects
# Generated 2026-07-23. All redirects are 301 (permanent).
# ============================================================

Options -MultiViews -Indexes
DirectoryIndex index.html
# Don't auto-append a trailing slash to directory URLs; /stories must be
# handled by the rewrite rules (stories.html), not mod_dir.
DirectorySlash Off

<IfModule mod_rewrite.c>
RewriteEngine On

# /stories clashes with the stories/ directory: serve the page directly
# and normalize /stories/ back to /stories (mod_dir would otherwise
# redirect to the bare directory).
RewriteRule ^stories$ /stories.html [L]
RewriteRule ^stories/$ /stories [R=301,L]

# ------------------------------------------------------------
# 1. Legacy top-level pages from the old travelai.com site
# ------------------------------------------------------------
RewriteRule ^about-us/?$        /about      [R=301,L]
RewriteRule ^our-brands/?$      /partners   [R=301,L]
RewriteRule ^applied-ai/?$      /network    [R=301,L]
RewriteRule ^contact-us/?$      /contact    [R=301,L]
RewriteRule ^privacy-policy/?$  /privacy    [R=301,L]
RewriteRule ^site-terms/?$      /terms      [R=301,L]
RewriteRule ^resources/blog/?$  /insights   [R=301,L]

# ------------------------------------------------------------
# 2. Old blog posts: /resources/<slug>/ -> new location
#    (generated from the old site's Yoast post-sitemap)
# ------------------------------------------------------------
RewriteRule ^resources/the-double-edged-sword-of-ai-in-the-travel-industry/?$ /blogs/the-double-edged-sword-of-ai-in-the-travel-industry [R=301,L]
